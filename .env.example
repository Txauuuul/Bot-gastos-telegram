# ============================================================================
# OBLIGATORIO
# ============================================================================

# Token de Telegram (obtén en @BotFather)
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI_SIN_COMILLAS

# IDs de Telegram autorizados (separados por coma)
# Envía /start al bot @userinfobot para obtener tu ID
# Si está vacío, cualquiera puede usar el bot
ALLOWED_USER_IDS=

# ============================================================================
# OPCIONAL: Google Drive (para sincronizar Excel)
# ============================================================================

# true = sincronizar Excel a Google Drive
# false = guardar solo en local
USE_GOOGLE_DRIVE=false

# ID de la carpeta de Google Drive donde guardar el Excel
# Ve a la carpeta en drive.google.com/drive/folders/ID_AQUI y copia el ID
GOOGLE_DRIVE_FOLDER_ID=

# ============================================================================
# SOLO PARA NUBE (PythonAnywhere / Heroku / etc)
# ============================================================================

# Si dejas esto VACÍO → Modo LOCAL (tu PC, usa polling)
# Si lo llenas → Modo NUBE (usa webhooks)
# Formato: https://tunombre.pythonanywhere.com
WEBHOOK_URL=

# Puerto para webhooks (PythonAnywhere usa 443)
WEBHOOK_PORT=443

# String secreto para seguridad (puede ser cualquier texto aleatorio)
WEBHOOK_SECRET=tu_password_secreto_aqui
